# ─────────────────────────────────────────────────────────────────────────────
# Mini Mercado storefront — environment template
# Copy to `.env.local` and fill in the real values. NEVER commit `.env.local`.
#
# Deploying elsewhere (Vercel, a VPS)? The `.env*` files are gitignored, so
# nothing here ships. Set every variable below in the host's own environment, or
# the app falls back to the defaults in src/config/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── POS API (server-side only) ───────────────────────────────────────────────
# The storefront never calls the POS API from the browser. `API_KEY` is read
# only by server code (see src/lib/api/client.ts) and is NEVER prefixed with
# NEXT_PUBLIC_, so it cannot leak into the client bundle.
API_BASE_URL=https://localhost/pos/api
API_KEY=YOUR_API_KEY

# Set to `true` to serve fixture data instead of calling the POS API.
# Useful for UI work when the backend is unreachable. Production must be `false`.
USE_MOCK_API=false

# Local XAMPP serves a self-signed certificate that Node rejects. `true` sets
# NODE_TLS_REJECT_UNAUTHORIZED=0 for the entire dev process — which is why Node
# logs a security warning — so leave it UNSET whenever the API host has a real
# certificate. Ignored when NODE_ENV=production.
# ALLOW_INSECURE_TLS=true

# ── Storefront ───────────────────────────────────────────────────────────────
# Canonical origin. Feeds canonicals, robots.txt, sitemap.xml and OG tags, and
# silently falls back to http://localhost:3000 when unset — so a production
# deploy MUST set this to the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Mini Mercado
NEXT_PUBLIC_STORE_EMAIL=hello@minimercado.example
NEXT_PUBLIC_STORE_PHONE=+351 000 000 000
NEXT_PUBLIC_STORE_ADDRESS=Rua Example 1, Lisboa
NEXT_PUBLIC_STORE_OPENING_HOURS=Mon–Sun 08:00–22:00

# ISO 4217 code used for Intl price formatting. The *symbol* is read from the
# POS `GET /api/settings` endpoint at runtime; this code is the fallback.
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR

# Base URL for products whose `image_url` is a bare relative path. Usually empty
# (the POS returns absolute Cloudinary URLs), but a POS returning
# "/uploads/foo.jpg" needs this set or those images resolve to a placeholder.
NEXT_PUBLIC_IMAGE_BASE_URL=

# Extra hostnames allowed for next/image, comma separated (Cloudinary is allowed
# by default). Example: cdn.example.com,*.images.example.com
# Read at BUILD time by next.config.ts — changing it requires a redeploy, so on a
# hosting platform it must be set before the build runs.
# NEXT_PUBLIC_IMAGE_HOSTS=

# ── Admin (/admin) ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
# Generate with: node scripts/hash-admin-password.mjs "your-password"
# Required in production — the plaintext ADMIN_PASSWORD fallback is dev-only.
ADMIN_PASSWORD_HASH=
# Random 32+ char string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Age-restricted products (off by default) ─────────────────────────────────
AGE_RESTRICTION_ENABLED=false
# The POS payload exposes `category: { id, name }` but no slug, so categories are
# matched by id or name (case-insensitive); products by id; SKUs by prefix.
AGE_RESTRICTED_PRODUCT_IDS=
AGE_RESTRICTED_CATEGORY_IDS=
AGE_RESTRICTED_CATEGORY_NAMES=
AGE_RESTRICTED_SKU_PREFIXES=

# ── Image uploads ────────────────────────────────────────────────────────────
# Max upload size in bytes (default 5 MB). Serverless hosts cap the request body
# below this — Vercel's limit is 4.5 MB — so lower it if uploads are used there.
# Note the admin uploader writes to `data/` in the working directory, which is
# read-only on serverless hosts; see docs/DEPLOYMENT.md.
IMAGE_UPLOAD_MAX_BYTES=5242880
